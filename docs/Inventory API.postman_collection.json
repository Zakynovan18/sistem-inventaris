            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));\n// Simpan token otomatis supaya request /items langsung terautentikasi\nif (pm.response.code === 200) {\n  pm.collectionVariables.set('token', pm.response.json().data.token);\n}"
            ]
